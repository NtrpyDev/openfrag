+    fn parse_server_rank_reveal_all(&mut self, bytes: &[u8]) -> Result<(), DemoParserError> {
+        let (seconds_till_shutdown, status) = match CcsUsrMsgServerRankRevealAll::decode(bytes) {
+            Ok(message) => {
+                let status = match message.reservation {
+                    Some(reservation) => ServerRankRevealAllStatus::Present(ServerRankReservation {
+                        account_ids: reservation.account_ids,
+                        party_ids: reservation.party_ids,
+                        teammate_colors: reservation.teammate_colors,
+                        game_type: reservation.game_type,
+                    }),
+                    None => ServerRankRevealAllStatus::MissingReservation,
+                };
+                (message.seconds_till_shutdown, status)
+            }
+            Err(_) => (None, ServerRankRevealAllStatus::Malformed),
+        };
+        self.server_rank_reveal_all.push(ServerRankRevealAllRecord {
+            tick: self.tick,
+            seconds_till_shutdown,
+            status,
+        });
+        Ok(())
+    }
