+//! Throwaway openfrag probe for CS_UM_ServerRankRevealAll.
+
+use ahash::AHashMap;
+use memmap2::MmapOptions;
+use parser::first_pass::parser_settings::ParserInputs;
+use parser::parse_demo::{Parser, ParsingMode};
+use parser::second_pass::parser_settings::create_huffman_lookup_table;
+use parser::second_pass::parser_settings::{ServerRankRevealAllRecord, ServerRankRevealAllStatus};
+use std::collections::BTreeMap;
+use std::env;
+use std::fs::File;
+
+fn settings<'a>(huffman_lookup_table: &'a Vec<(u8, u8)>) -> ParserInputs<'a> {
+    ParserInputs {
+        real_name_to_og_name: AHashMap::default(),
+        wanted_players: vec![],
+        wanted_player_props: vec![],
+        wanted_other_props: vec![],
+        wanted_prop_states: AHashMap::default(),
+        wanted_ticks: vec![],
+        wanted_events: vec![],
+        parse_ents: false,
+        parse_projectiles: false,
+        parse_grenades: false,
+        only_header: false,
+        only_convars: false,
+        huffman_lookup_table,
+        order_by_steamid: false,
+        list_props: false,
+        fallback_bytes: None,
+    }
+}
+
+fn main() {
+    let demo_paths: Vec<String> = env::args().skip(1).collect();
+    if demo_paths.is_empty() {
+        eprintln!("usage: party_probe <demo.dem> [demo.dem ...]");
+        std::process::exit(2);
+    }
+
+    let huffman_lookup_table = create_huffman_lookup_table();
+    for demo_path in demo_paths {
+        println!("OPENFRAG_DEMO_BEGIN path={demo_path}");
+        let file = File::open(&demo_path).expect("open Demo");
+        let mmap = unsafe { MmapOptions::new().map(&file).expect("map Demo") };
+        let mut parser = Parser::new(settings(&huffman_lookup_table), ParsingMode::ForceSingleThreaded);
+        let output = parser.parse_demo(&mmap).expect("parse Demo");
+        if output.server_rank_reveal_all.is_empty() {
+            println!("message_350=absent");
+        } else {
+            for (index, record) in output.server_rank_reveal_all.iter().enumerate() {
+                print_record(index, record);
+            }
+        }
+        println!("OPENFRAG_DEMO_END path={demo_path}");
+    }
+}
+
+fn print_record(index: usize, record: &ServerRankRevealAllRecord) {
+    match &record.status {
+        ServerRankRevealAllStatus::Malformed => {
+            println!("message_350[{index}] tick={} status=malformed", record.tick);
+        }
+        ServerRankRevealAllStatus::MissingReservation => {
+            println!("message_350[{index}] tick={} status=missing_reservation", record.tick);
+        }
+        ServerRankRevealAllStatus::Present(reservation) => {
+            let mut labels = BTreeMap::new();
+            let mut next_label = 1_usize;
+            let redacted_parties: Vec<String> = reservation
+                .party_ids
+                .iter()
+                .map(|id| {
+                    if *id == 0 {
+                        "0".to_string()
+                    } else {
+                        let label = labels.entry(*id).or_insert_with(|| {
+                            let current = next_label;
+                            next_label += 1;
+                            current
+                        });
+                        format!("P{label}")
+                    }
+                })
+                .collect();
+            let account_zero_positions: Vec<usize> = reservation
+                .account_ids
+                .iter()
+                .enumerate()
+                .filter_map(|(position, id)| (*id == 0).then_some(position))
+                .collect();
+            println!(
+                "message_350[{index}] tick={} status=present seconds={:?} accounts={{len:{},zero_positions:{account_zero_positions:?}}} parties={{len:{},labels:{redacted_parties:?}}} teammate_colors={{len:{},values:{:?}}} game_type={:?}",
+                record.tick,
+                record.seconds_till_shutdown,
+                reservation.account_ids.len(),
+                reservation.party_ids.len(),
+                reservation.teammate_colors.len(),
+                reservation.teammate_colors,
+                reservation.game_type,
+            );
+        }
+    }
+}
